  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Links out to companion documents and downloads.",
      "html": "<a class=\"ds-btn\" href=\"#\">Open the build manual</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;min-height:38px;padding:0 16px;border:1px solid var(--accent,#5B9DFF);border-radius:6px;background:var(--accent,#5B9DFF);color:var(--accent-fg,#0E1116);font:500 .875rem \"IBM Plex Sans\",system-ui,sans-serif;text-decoration:none;transition:background .12s,border-color .12s}.ds-btn:hover{background:var(--accent-2,#8AB8FF);border-color:var(--accent-2,#8AB8FF)}.ds-btn:focus-visible{outline:2px solid var(--accent,#5B9DFF);outline-offset:2px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary link-out beside a primary button.",
      "html": "<a class=\"ds-btn-quiet\" href=\"#\">Download STEP</a>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;min-height:38px;padding:0 16px;border:1px solid var(--line-2,#2A313C);border-radius:6px;background:transparent;color:var(--fg,#E6EAF0);font:500 .875rem \"IBM Plex Sans\",system-ui,sans-serif;text-decoration:none;transition:background .12s,border-color .12s}.ds-btn-quiet:hover{background:var(--surface-2,#1C222B);border-color:var(--line-3,#3A4250)}.ds-btn-quiet:focus-visible{outline:2px solid var(--accent,#5B9DFF);outline-offset:2px}"
    },
    {
      "name": "Search Trigger",
      "kind": "input",
      "refersTo": "search-trigger",
      "description": "Top-bar button that opens the Ctrl K search palette.",
      "html": "<button class=\"ds-search\" type=\"button\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6\"/><path d=\"M15 15l5 5\"/></svg><span>Search</span><kbd class=\"ds-kbd\">Ctrl K</kbd></button>",
      "css": ".ds-search{display:inline-flex;align-items:center;gap:8px;min-height:36px;min-width:220px;padding:0 9px;border:1px solid var(--line-2,#2A313C);border-radius:6px;background:var(--surface,#151A21);color:var(--fg-3,#828C9A);font:500 .8125rem \"IBM Plex Sans\",system-ui,sans-serif;cursor:pointer;transition:border-color .12s,color .12s}.ds-search:hover{border-color:var(--line-3,#3A4250);color:var(--fg-2,#A3ADBA)}.ds-search:focus-visible{outline:2px solid var(--accent,#5B9DFF);outline-offset:2px}.ds-kbd{margin-left:auto;font:500 .6875rem/1 \"IBM Plex Mono\",monospace;border:1px solid var(--line-2,#2A313C);border-radius:4px;padding:3px 5px;background:var(--surface,#151A21)}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Persistent left sidebar grouped by area; the current page has a raised fill and a blue icon.",
      "html": "<nav class=\"ds-nav\"><p class=\"ds-nav-g\">Design</p><a href=\"#\" class=\"ds-nav-a\" aria-current=\"page\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" aria-hidden=\"true\"><path d=\"M12 3l8 4.5v9L12 21l-8-4.5v-9z\"/><path d=\"M4 7.5l8 4.5 8-4.5M12 12v9\"/></svg>CAD model</a><a href=\"#\" class=\"ds-nav-a\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" aria-hidden=\"true\"><path d=\"M3 10c4-1 7-1 10 0s5 1 8 0M3 15c4-1 7-1 10 0s5 1 8 0\"/></svg>Aerodynamics</a></nav>",
      "css": ".ds-nav{width:248px;padding:4px 10px;background:var(--bg,#0E1116)}.ds-nav-g{margin:12px 10px 6px;font:500 .75rem/1 \"IBM Plex Sans\",system-ui,sans-serif;color:var(--fg-3,#828C9A);letter-spacing:.01em}.ds-nav-a{display:flex;align-items:center;gap:10px;min-height:34px;padding:0 10px;border-radius:6px;color:var(--fg-2,#A3ADBA);font:500 .875rem \"IBM Plex Sans\",system-ui,sans-serif;text-decoration:none}.ds-nav-a svg{color:var(--fg-3,#828C9A)}.ds-nav-a:hover{background:var(--surface-2,#1C222B);color:var(--fg,#E6EAF0)}.ds-nav-a[aria-current=\"page\"]{background:var(--surface-2,#1C222B);color:var(--fg,#E6EAF0)}.ds-nav-a[aria-current=\"page\"] svg{color:var(--accent,#5B9DFF)}.ds-nav-a:focus-visible{outline:2px solid var(--accent,#5B9DFF);outline-offset:2px}"
    },
    {
      "name": "Sub-tabs",
      "kind": "nav",
      "refersTo": "sub-tab",
      "description": "Tabs built from a long chapter's section headings; Summary is the lead-in.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><a role=\"tab\" aria-selected=\"true\" href=\"#\">Summary</a><a role=\"tab\" aria-selected=\"false\" href=\"#\">Drag</a><a role=\"tab\" aria-selected=\"false\" href=\"#\">CFD</a><a role=\"tab\" aria-selected=\"false\" href=\"#\">Flow field</a></div>",
      "css": ".ds-tabs{display:flex;gap:2px;border-bottom:1px solid var(--line,#20262F)}.ds-tabs a{display:inline-flex;align-items:center;min-height:40px;padding:0 12px;margin-bottom:-1px;border-bottom:2px solid transparent;color:var(--fg-3,#828C9A);font:500 .875rem \"IBM Plex Sans\",system-ui,sans-serif;text-decoration:none}.ds-tabs a:hover{color:var(--fg,#E6EAF0)}.ds-tabs a[aria-selected=\"true\"]{color:var(--fg,#E6EAF0);border-bottom-color:var(--accent,#5B9DFF)}.ds-tabs a:focus-visible{outline:2px solid var(--accent,#5B9DFF);outline-offset:2px}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "chip-met",
      "description": "Tinted, borderless verdict chips; EST is the one outlined mark.",
      "html": "<span class=\"ds-chip ds-met\">Met</span> <span class=\"ds-chip ds-risk\">At risk</span> <span class=\"ds-chip ds-fail\">Fail</span> <span class=\"ds-chip ds-open\">Open</span> <span class=\"ds-est\">Est</span>",
      "css": ".ds-chip{display:inline-block;font:600 .75rem/1 \"IBM Plex Sans\",system-ui,sans-serif;padding:4px 7px;border-radius:5px;white-space:nowrap}.ds-met{color:var(--ok,#5FD3A2);background:var(--ok-soft,#10301F)}.ds-risk{color:var(--warn,#F0C46E);background:var(--warn-soft,#33270F)}.ds-fail{color:var(--bad,#F59393);background:var(--bad-soft,#391B1D)}.ds-open{color:var(--open,#B9AEFF);background:var(--open-soft,#251F45)}.ds-est{display:inline-block;font:600 .6875rem/1 \"IBM Plex Mono\",monospace;letter-spacing:.04em;text-transform:uppercase;color:var(--fg-2,#A3ADBA);border:1px solid var(--line-3,#3A4250);border-radius:4px;padding:2px 4px}"
    },
    {
      "name": "Key Parameter List",
      "kind": "card",
      "refersTo": "key-parameter-row",
      "description": "A bordered spec list of label, mono value and note; never hero tiles.",
      "html": "<div class=\"ds-kpis\"><div class=\"ds-kpi\"><span class=\"ds-l\">Committed spend (R6)</span><span class=\"ds-v ds-ok\">$1,842</span><span class=\"ds-s\">cap $2,000 incl. tax + shipping</span></div><div class=\"ds-kpi\"><span class=\"ds-l\">Sized MTOW (R2)</span><span class=\"ds-v ds-warn\">7.42 kg</span><span class=\"ds-s\">below the 8 to 15 kg working target</span></div></div>",
      "css": ".ds-kpis{border:1px solid var(--line,#20262F);border-radius:8px;background:var(--surface,#151A21);overflow:hidden;max-width:420px}.ds-kpi{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 18px;align-items:baseline;padding:10px 14px;border-bottom:1px solid var(--line,#20262F)}.ds-kpi:last-child{border-bottom:0}.ds-l{font:500 .8125rem/1.4 \"IBM Plex Sans\",system-ui,sans-serif;color:var(--fg-2,#A3ADBA)}.ds-v{font:500 1rem/1.3 \"IBM Plex Mono\",monospace;letter-spacing:-.01em;color:var(--fg,#E6EAF0);text-align:right}.ds-ok{color:var(--ok,#5FD3A2)}.ds-warn{color:var(--warn,#F0C46E)}.ds-s{grid-column:1/-1;font:400 .8125rem/1.45 \"IBM Plex Sans\",system-ui,sans-serif;color:var(--fg-3,#828C9A)}"
    },
    {
      "name": "Panel with Source",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat 1px panel; every result names its source file in mono beneath.",
      "html": "<div class=\"ds-panel\"><h4>Cruise drag build-up</h4><p>Total parasite drag at 20 m/s, with the leg fairings fitted.</p><p class=\"ds-src\"><b>Source</b> analysis/aero/out/drag_buildup.json</p></div>",
      "css": ".ds-panel{background:var(--surface,#151A21);border:1px solid var(--line,#20262F);border-radius:8px;padding:16px 18px;color:var(--fg,#E6EAF0);font:400 .9375rem/1.6 \"IBM Plex Sans\",system-ui,sans-serif;max-width:520px}.ds-panel h4{margin:0 0 6px;font:600 .9375rem/1.15 \"IBM Plex Sans\",system-ui,sans-serif;letter-spacing:-.012em}.ds-panel p{margin:0 0 8px;color:var(--fg-2,#A3ADBA)}.ds-src{font:400 .75rem/1.55 \"IBM Plex Mono\",monospace;color:var(--fg-3,#828C9A)!important}.ds-src b{font-family:\"IBM Plex Sans\",system-ui,sans-serif;font-weight:600;margin-right:4px}"
    },
    {
      "name": "Viewer Toggles",
      "kind": "custom",
      "refersTo": "viewer-toggle",
      "description": "Segmented controls on the CAD and flow viewer bars; pressed = blue wash with a blue inset rule.",
      "html": "<div class=\"ds-seg\"><button type=\"button\" aria-pressed=\"true\">Assembled</button><button type=\"button\" aria-pressed=\"false\">Exploded</button><button type=\"button\" aria-pressed=\"false\">X-ray</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px}.ds-seg button{min-height:34px;padding:0 15px;border:0;border-radius:5px;background:var(--surface-2,#1C222B);color:var(--fg-2,#A3ADBA);font:500 .8125rem \"IBM Plex Sans\",system-ui,sans-serif;cursor:pointer;transition:background .12s,color .12s}.ds-seg button:hover{background:var(--surface-3,#242B35);color:var(--fg,#E6EAF0)}.ds-seg button[aria-pressed=\"true\"]{background:var(--accent-soft,#15243A);color:var(--fg,#E6EAF0);box-shadow:inset 0 0 0 1px var(--accent-line,#2C4D7D)}.ds-seg button:focus-visible{outline:2px solid var(--accent,#5B9DFF);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Engineering Workspace",
    "overview": "The review is a tool the client and the team work inside, not a document they scroll. It borrows its presentation of geometry from Onshape, its organisation of analysis cases from SimScale, and its type, spacing and navigation from Linear. A sticky top bar and a persistent left sidebar frame a single workspace; each chapter is a page, long chapters split into sub-tabs, and wherever the project owns a viewer (the live SOLIDWORKS model, the drawing set, the CFD flow field) that viewer leads the page with an inspector beside it.\n\nThe surface is quiet so the engineering can be loud. Dark graphite is the default and a light theme is one click away; both are built from the same token names. One blue signal accent marks where the reader is and what is selected. Green, amber, red and violet are reserved for verdicts, and every other hue belongs to data. Panels are flat with 1px borders and 8px corners; nothing floats except popovers. Numbers, parameters and source paths are set in IBM Plex Mono so a reader can tell measured values from prose at a glance.\n\nThe traditional report is not abandoned. Report view and print render every page in order from the same content as one document, with a cover, revision record, approvals, contents and every disclosure open.",
    "keyCharacteristics": [
      "App shell: 52px sticky top bar, 248px sidebar, workspace capped at 1200px.",
      "Pages are chapters; sub-tabs come from the chapter's own section headings; hash routes per page and tab.",
      "Visual-first workspaces: the viewer leads, a 300px inspector sits beside it.",
      "IBM Plex Sans for prose and UI, IBM Plex Mono for anything measured or cited.",
      "One blue signal accent; verdict colours carry status only; other hues are data.",
      "Flat 1px panels, 8px radius, shadows on popovers only.",
      "Key parameters are a spec list, never hero metric tiles."
