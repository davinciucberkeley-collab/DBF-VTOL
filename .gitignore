# compiled helper tools (rebuild with cad/build.ps1) and vendor interop assemblies
*.exe
*.dll
*.pdb
# SOLIDWORKS lock/temp files and solver logs
~$*
*.SLDBAK
cad/sim/*BenchMark-Solver.txt
cad/sim/PerformanceLog.txt
# local tooling
.claude/
__pycache__/
node_modules/

# third-party downloads
*.pdf
# SOLIDWORKS Simulation result databases (regenerate with cad/Sim.exe; studies are saved inside cad/sim/*.SLDPRT)
cad/sim/*.CWR
cad/sim/*.gsz
cad/sim/*.LOG
cad/sim/*.HTQ

# Impeccable detector snapshots (local before/after comparisons)
before.json
after.json

# JPEG copies of the renders: build.mjs regenerates them on Windows; the four the page embeds are committed
# so a runner without the converter (CI) builds the same page
review/img/*
!review/img/VTOL_Concept_iso.jpg
!review/img/FEA_Boom_vonMises.jpg
!review/img/FEA_Spar_vonMises.jpg
!review/img/THERM_Motor_steady.jpg

# the drawing set PDF is a deliverable
!cad/drawings/DBF-DRW-001.PDF
review/_preview/

# downloaded ArduPilot parameter metadata (check_params.py fetches it again)
firmware/tools/cache/
# SOLIDWORKS thermal result databases (regenerate with cad/Thermal.exe; studies are saved in cad/sim/thermal/*.SLDPRT)
cad/sim/thermal/*.CWR
cad/sim/thermal/*.HTQ
cad/sim/thermal/*.HTO
cad/sim/thermal/*.P42
cad/sim/thermal/*.gsz
cad/sim/thermal/*.MAS
cad/sim/thermal/*.LOG
cad/sim/thermal/PerformanceLog.txt
cad/sim/thermal/PROBE_*
# exported thermal fields (5-8 MB each; the page uses the downsampled copy in analysis/thermal/thermal_results.json)
cad/sim/thermal/fields/
